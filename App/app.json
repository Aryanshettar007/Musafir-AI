{
  "expo": {
    "name": "Musafir AI",
    "slug": "musafir-ai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/ios-icon-default.png",
    "scheme": "musafir",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.musafir-ai.app",
      "icon": "./assets/images/ios-icon-default.png",
      "googleServicesFile": "./src/config/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "Musafir AI uses your location to discover nearby travel highlights and trigger audio guides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Musafir AI needs background location access to trigger audio stories automatically as you travel.",
        "NSMicrophoneUsageDescription": "Musafir AI needs microphone access so you can speak to the narrator, ask questions during your trip, and record audio samples to create your custom cloned voice.",
        "NSPhotoLibraryUsageDescription": "Musafir AI only accesses the photo you select to use as a profile picture for your custom voice."
      }
    },
    "android": {
      "package": "com.musafir_ai.app",
      "versionCode": 1,
      "googleServicesFile": "./src/config/google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCJPd8b6s_DbW1sNxkbb7VwCuc7KjQJ8bo"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FCF7ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF7ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Musafir AI needs background location access to trigger audio stories automatically as you travel.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Musafir AI needs access to your photo library to let you select a profile picture for your custom voice."
        }
      ],
      "./plugins/withAndroidPlayConsoleFixes.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "backendUrl": "https://musafir-ai.onrender.com",
      "router": {},
      "eas": {
        "projectId": "edbad38a-f972-4542-bd2b-b8f90b8b1108"
      }
    }
  }
}
