{
  "expo": {
    "name": "Musafir AI",
    "slug": "musafir-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon-default.png",
    "scheme": "musafir",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.musafir-ai.app",
      "icon": "./assets/images/ios-icon-default.png",
      "googleServicesFile": "./src/config/GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"],
        "NSLocationWhenInUseUsageDescription": "Musafir AI uses your location to discover nearby travel highlights and trigger audio guides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Musafir AI needs background location access to trigger audio stories automatically as you travel.",
        "NSMicrophoneUsageDescription": "Musafir AI needs microphone access so you can speak to the narrator and ask questions during your trip."
      }
    },
    "android": {
      "package": "com.musafir.app",
      "googleServicesFile": "./src/config/google-services.json",

      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FCF7ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF7ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Musafir AI needs background location access to trigger audio stories automatically as you travel.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "backendUrl": "http://192.168.1.30:3000"
    }
  }
}
