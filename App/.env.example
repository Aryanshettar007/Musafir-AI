# Musafir AI Environment Configuration Template
# Copy this file to .env or .env.local

# 1. Local Network Testing (Works on iOS Simulator, Android Emulator & Physical Devices on same Wi-Fi):
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.30:3000

# 2. Production / Publishing (e.g. deployed to Google Cloud Run, Render, Railway, AWS):
# EXPO_PUBLIC_BACKEND_URL=https://api.musafir.ai
