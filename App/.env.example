# Backend URL
EXPO_PUBLIC_BACKEND_URL=http://172.20.0.21:3000

# Google Maps API - Web (Maps JavaScript API)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps API - Android (Maps SDK for Android)
ANDROID_GOOGLE_MAPS_API_KEY=

# Google Auth - Firebase Web Client ID (from Firebase Console -> Authentication -> Google -> Web SDK configuration)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Auth - iOS Client ID (optional, found in GoogleService-Info.plist)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=