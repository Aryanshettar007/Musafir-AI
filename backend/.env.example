PORT=3000
MONGODB_URI=mongodb://localhost:27017/musafir_ai
# Optional, defaults to musafir_ai
MONGODB_DB_NAME=

GNANI_API_KEY=
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Gemini free tier: requests per minute are per model; concurrency is shared by both
GEMINI_CONCURRENCY=2
GEMINI_LITE_RPM=10
GEMINI_FLASH_RPM=5
# Optional: comma-separated language ids that skip flash-lite and use flash directly (e.g. kn-IN,te-IN)
GEMINI_FLASH_LANGUAGES=

# Trip limits
TRIPS_PER_DAY=10
MAX_ROUTE_KM=1200
# Optional: Wikipedia API User-Agent (include a contact URL)
WIKIPEDIA_USER_AGENT=

# Firebase project the app signs users into (not a secret; only used to verify ID tokens)
FIREBASE_PROJECT_ID=musafir-ai-a7114
# Optional: comma-separated browser origins allowed by CORS (the mobile app needs none)
CORS_ORIGINS=

# Audio storage: "local" (files under LOCAL_STORAGE_DIR, served at /files) or "s3" (private Backblaze B2 bucket)
STORAGE_DRIVER=local
# Optional: how a phone reaches this server for local file URLs, e.g. http://192.168.1.5:3000
PUBLIC_BASE_URL=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=Musafir-AI
S3_FORCE_PATH_STYLE=true
# Use a B2 application key restricted to the bucket (listFiles, readFiles, writeFiles, deleteFiles)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Signed download URL lifetime, max 604800 (7 days)
AUDIO_URL_TTL_SECONDS=604800

APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.musafir-ai.app
APPLE_PRIVATE_KEY=